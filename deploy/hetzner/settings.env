# Trading settings kept in git, so a push to master changes them. Loaded after
# /etc/tempest/bot.env (docker-compose.yml), so these win over the same keys
# there. Secrets and the owner's other risk settings (LEVERAGE,
# DAILY_DRAWDOWN_PCT) stay in bot.env on the server. Never put a key here:
# this repo is public.
#
# 2026-11-07 (owner): the lab's only setup that held up out of sample,
# breakout on 1d trend / 4h signal; three liquid pairs; at most three
# positions, each with a third of the margin.
# 2026-11-10 (owner): fewer, larger positions: at most two, half the margin
# each. One slot at 20x would put liquidation (~5 %) inside the usual 4h stop
# (6-8 %), so most entries would be refused.
# 2026-11-13 (owner): the same ten pairs the nightly lab measures, so live
# trades what the numbers come from. Still at most two positions.
# 2026-11-14 (owner): four positions, to carry more shorts while the market
# falls. Each gets a quarter of the margin; risk per trade is unchanged, so
# four stops hit together cost up to four times RISK_PER_TRADE_PCT.
# 2026-11-14 evening (owner): only the four majors; the rest of the market
# follows them. The lab's numbers were measured on ten pairs, so the edge
# is not confirmed for these four alone.
TRADING_PAIRS=BTCUSDC,ETHUSDC,BNBUSDC,XRPUSDC
# 2026-11-14 evening (owner): back to two positions, larger each (risk 30 %),
# after closing everything in a market that is heavily oversold.
# 2026-11-20 (owner, riding the fall): three positions, a third of the
# margin each, so a BNB or XRP short can join the two open ones. Three stops
# hit together cost up to about 90 % of the account.
MAX_OPEN_POSITIONS=3
TREND_INTERVAL=1d
SIGNAL_INTERVAL=4h
# 2026-11-10 (owner): once a position is up 100 % on its margin (5 % at
# 20x), its stop moves to the entry price. Lab, 2 years, same 5 % move:
# profit factor 1.35 -> 1.44 out of sample on ten pairs, 1.82 -> 1.66 on
# BTC/ETH/SOL; lower drawdowns in three of four runs.
BREAKEVEN_ROI_PCT=100
# 2026-11-14 (owner: "do what you think is best", after the account passed 250):
# 15 % of equity at the stop per trade, down from 80 % (which the margin cap
# held at ~58 %). Two stops together cost ~30 %, not the whole account. A simple
# model (37 % hits, 2R targets) gives ~48 % to reach 1000 from 253 at 15 %,
# against ~25 % at the old size. Applies to new positions only.
# 2026-11-14 (owner, same day): 15 was too small for him; 20 is his floor ("at least 20 or 40").
RISK_PER_TRADE_PCT=30

# 2026-11-16: the skim trial worked (6.97 USDC moved to spot, futures 203.03).
# Off again until the owner's rule is built: withdraw half of every 150 USDC
# earned and let the other half raise the stake.

# 2026-11-16 (owner): half-out. When equity reaches the base + 150 on a flat
# account, half of the gain over the base goes to spot as USDC and the rest
# raises the base (210 -> e.g. 285 at 360). Losses never lower the base. A
# manual deposit looks like gain (half of it is taken out); a manual
# withdrawal does not lower the base; changing SKIM_STAKE_USDC restarts it.
# Do not combine with TOPUP_*.
SKIM_STAKE_USDC=210
SKIM_STEP_USDC=150
SKIM_SHARE_PCT=50

# 2026-11-19 (owner): trailing stop instead of the fixed 2R target. The stop
# trails the mark at 3 x ATR and only tightens; new entries get no target.
# Lab, 2 years, 10x as a stand-in for live cross margin, risk 30 %: on BTC,
# ETH, BNB, XRP profit factor 1.27 -> 1.28 in sample, 2.36 -> 3.33 out of
# sample (31 OOS trades); on ten pairs 1.31 -> 1.24 and 2.07 -> 2.36.
# Live trails the 5-minute mark with the current ATR; the lab trails the
# bar extreme with the ATR at entry, so live is close to, not the same as,
# what was measured.
# 2026-11-20 (owner asked to take profit sooner): 2 x ATR instead of 3, and
# no partial take-profit. Lab, 2 years, same stand-in as above: BTC, ETH,
# BNB, XRP PF 1.40 -> 1.58 in sample, 3.58 -> 3.78 out of sample; ten pairs
# 1.32 -> 1.47 and 2.47 -> 2.70. Half out at 2R (PARTIAL_TP_PCT=50, lab
# only) did worse than 2 x ATR alone in every run.
TRAILING_STOP_ATR=2

# 2026-11-21 (owner, «pause boten»): no new positions until this is removed.
# Open positions keep their stops, break-even, trail and signal exits; the
# half-out rule still runs once the account is flat.
PAUSE_ENTRIES=false
# 2026-11-21 09:30 (owner, «start boten»): trading again.

# 2026-11-21 (owner, «bygg låseregelen»): what he did by hand, as a rule.
# Daily RSI(14) under 15 on a short (over 85 on a long) with the trade in
# profit: sell half once at market; the rest rides the trail. Lab, 2 years,
# trail 2 x ATR: BTC/ETH/BNB/XRP PF 1.575 -> 1.585 in sample, 3.78 -> 3.83
# out of sample; ten pairs 1.47 -> 1.51 and 2.70 -> 2.75. At 20 it did worse.
LOCK_RSI=15
LOCK_PCT=50

# 2026-11-21 (owner, «bygg 1h-timing»): no short while the last closed
# hour's RSI(14) is under 25, no long while it is over 75; the 4h signal is
# checked again next cycle. Lab, 2 years, with the trail and the lock rule:
# BTC/ETH/BNB/XRP PF 1.59 -> 1.86 in sample, 3.83 -> 3.89 out of sample,
# drawdown 98 -> 91 % and 79 -> 64 %; ten pairs 1.51 -> 1.55 and 2.75 -> 3.67.
# A third fewer trades. At 30 out of sample got worse.
ENTRY_RSI_1H=25
