# Trading settings kept in git, so a push to master changes them. Loaded after
# /etc/tempest/bot.env (docker-compose.yml), so these win over the same keys
# there. Secrets and the owner's risk settings (LEVERAGE, RISK_PER_TRADE_PCT,
# DAILY_DRAWDOWN_PCT) stay in bot.env on the server. Never put a key here:
# this repo is public.
#
# 2026-11-07 (owner): the lab's only setup that held up out of sample,
# breakout on 1d trend / 4h signal; three liquid pairs; at most three
# positions, each with a third of the margin.
TRADING_PAIRS=BTCUSDC,ETHUSDC,SOLUSDC
MAX_OPEN_POSITIONS=3
TREND_INTERVAL=1d
SIGNAL_INTERVAL=4h
