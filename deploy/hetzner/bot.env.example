# Copy to /etc/tempest/bot.env on the server (chmod 600) and fill in.
# Mirrors the tempest-bot variables on Railway.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
MARKET=futures
LEVERAGE=5
STRATEGY=breakout
TREND_INTERVAL=1d
SIGNAL_INTERVAL=4h
QUOTE_ASSET=USDC
TRADING_PAIRS=ETHUSDC,BTCUSDC,SOLUSDC,XRPUSDC,BNBUSDC,DOGEUSDC,ADAUSDC,LINKUSDC,AVAXUSDC,LTCUSDC
RISK_PER_TRADE_PCT=2
# Copy the remaining values from the tempest-bot service on Railway.
DAILY_DRAWDOWN_PCT=25
POLL_INTERVAL_SECONDS=900
LOG_LEVEL=info
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
