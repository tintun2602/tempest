# Copy to /etc/tempest/lab.env on the server (chmod 600).
# The lab reads only public market data; the key is required by the config
# loader but never used, so a placeholder is fine.
BINANCE_API_KEY=unused
BINANCE_API_SECRET=unused
BINANCE_BASE_URL=https://api.binance.com
MODE=lab
LAB_MARKET=futures
LAB_DAYS=730
LEVERAGE=5
STRATEGY=breakout
TREND_INTERVAL=1d
SIGNAL_INTERVAL=4h
QUOTE_ASSET=USDC
TRADING_PAIRS=ETHUSDC,BTCUSDC,SOLUSDC,XRPUSDC,BNBUSDC,DOGEUSDC,ADAUSDC,LINKUSDC,AVAXUSDC,LTCUSDC
RISK_PER_TRADE_PCT=2
LOG_LEVEL=info
